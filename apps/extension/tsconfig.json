{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "module": "es2020",
    "target": "es2021",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": ["./dev", "./build", "./dist"]
}
