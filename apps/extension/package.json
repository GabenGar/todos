{
  "name": "link-overwatch",
  "version": "0.1.0",
  "author": "Gabengar",
  "license": "MPL-2.0",
  "description": "An extension to watch out for the URLs.",
  "private": true,
  "homepage": "https://github.com/GabenGar/todos#readme",
  "main": "./src/manifest.json",
  "keywords": [
    "webextensions",
    "firefox"
  ],
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "build": "webpack --config webpack.prod.mjs && web-ext build --no-config-discovery --config=web-ext-config.mjs --source-dir=build --artifacts-dir=dist",
    "start": "web-ext run --no-config-discovery --config=web-ext-config.mjs --source-dir=build",
    "dev": "node scripts/dev.mjs",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "validate": "node scripts/validate.mjs"
  },
  "imports": {
    "#popup/*": "./src/popup/*/index.ts",
    "#options/*": "./src/options/*/index.ts",
    "#*": "./src/*/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabenGar/todos.git"
  },
  "bugs": {
    "url": "https://github.com/GabenGar/todos/issues"
  },
  "dependencies": {
    "@repo/react-router": "*",
    "@repo/ui": "*",
    "clsx": "2.1.1",
    "i18next": "27.1.1",
    "i18next-resources-to-backend": "1.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@repo/biome-config": "*",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webextension-polyfill": "0.12.6",
    "@types/webpack-bundle-analyzer": "4.7.0",
    "concurrently": "10.0.7",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "sass": "1.108.2",
    "sass-loader": "17.1.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "web-ext": "10.8.0",
    "webextension-polyfill": "0.12.0",
    "webpack": "5.112.2",
    "webpack-bundle-analyzer": "5.4.2",
    "webpack-cli": "7.3.1",
    "webpack-merge": "6.0.1"
  }
}
