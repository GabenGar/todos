{
  "name": "oikia",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "build": "react-router build",
    "start": "node ./scripts/start.js",
    "dev": "node ./scripts/dev.js",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check --formatter-enabled=false --linter-enabled=false --write && react-router typegen && tsc --build",
    "develop-database-purge": "node scripts/develop/database/purge.mjs"
  },
  "imports": {
    "#localization/*": "./src/translation/language/*",
    "#translation/lib": "./src/translation/lib/index.ts",
    "#translation/*": "./src/translation/language/*",
    "#environment": "./src/environment/index.ts",
    "#environment/*": "./src/environment/*/index.ts",
    "#lib/*": "./src/lib/*/index.ts",
    "#hooks": "./src/hooks/index.ts",
    "#components/*": "./src/components/*/index.ts",
    "#entities/*": "./src/entities/*/index.ts",
    "#database": "./src/.server/database/index.ts",
    "#database/*": "./src/.server/database/*/index.ts",
    "#server/*": "./src/.server/*/index.ts",
    "#client/*": "./src/.client/*/index.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@exodus/schemasafe": "1.3.0",
    "@react-router/express": "8.5.1",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@repo/ui": "*",
    "bcp-47": "2.1.2",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "compression": "1.8.2",
    "date-fns": "4.4.0",
    "express": "5.3.0",
    "i18next": "27.1.1",
    "i18next-resources-to-backend": "1.2.4",
    "isbot": "5.2.3",
    "iso-639-1": "3.1.5",
    "morgan": "1.12.1",
    "nanoid": "6.0.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "pg-promise": "12.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@react-router/dev": "8.5.1",
    "@repo/biome-config": "*",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/morgan": "1.9.10",
    "@types/node": "^22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
