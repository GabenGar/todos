{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PublicConfiguration",
  "description": "Public configuration, all values of which will be inlined on client.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_title",
    "supported_languages",
    "default_language",
    "source_code_url"
  ],
  "properties": {
    "site_title": {
      "description": "Title of the site.",
      "type": "string",
      "pattern": "^[\\s\\S]*$",
      "default": "Oikia Dev"
    },
    "supported_languages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/supported_language"
      }
    },
    "default_language": {
      "$ref": "#/definitions/supported_language"
    },
    "source_code_url": {
      "description": "A link to source code.",
      "type": "string",
      "pattern": "^[\\s\\S]*$"
    },
    "is_translation_debug_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "definitions": {
    "supported_language": {
      "enum": ["en", "ru"]
    }
  }
}
