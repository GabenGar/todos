{
  "name": "spooder",
  "version": "0.0.1",
  "author": "Gabengar",
  "license": "MPL-2.0",
  "description": "An extension for almost all SEO needs.",
  "private": true,
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "build": "webpack --config webpack.prod.mjs && web-ext build --no-config-discovery --config=./web-ext-config.mjs --source-dir=build --artifacts-dir=dist",
    "start": "web-ext run --no-config-discovery --config=web-ext-config.mjs --source-dir=build",
    "dev": "node scripts/dev.mjs",
    "lint": "web-ext lint --no-config-discovery --config=./web-ext-config.mjs",
    "format": "biome format --write",
    "check": "biome check --formatter-enabled=false --linter-enabled=false --write && tsc --noEmit",
    "validate": "node scripts/validate.mjs"
  },
  "imports": {
    "#translation": "./src/translation/lib/index.ts",
    "#translation/*": "./src/translation/language/*",
    "#*": "./src/*/index.ts"
  },
  "dependencies": {
    "@repo/react-router": "*",
    "@repo/ui": "*",
    "clsx": "^2.1.1",
    "i18next": "26.4.2",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "7.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@repo/biome-config": "*",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.0",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "web-ext": "^10.0.0",
    "webextension-polyfill": "^0.12.0",
    "webpack": "^5.112.0",
    "webpack-bundle-analyzer": "^5.2.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  }
}