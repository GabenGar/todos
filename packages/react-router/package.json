{
  "name": "@repo/react-router",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --formatter-enabled=false --linter-enabled=false --write && tsc --noEmit"
  },
  "exports": {
    "./translation": "./src/translation/lib/index.ts",
    "./translation/*": "./src/translation/language/*",
    "./*": "./src/*/index.ts"
  },
  "imports": {
    "#translation/lib": "./src/translation/lib/index.ts",
    "#translation/*": "./src/translation/language/*",
    "#*": "./src/*/index.ts"
  },
  "dependencies": {
    "@repo/ui": "*",
    "clsx": "^2.1.1",
    "i18next": "27.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@react-router/dev": "8.5.1",
    "@repo/biome-config": "*",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sass": "^1.97.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.1"
  }
}
