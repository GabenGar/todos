{
  "name": "@repo/react-router",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --formatter-enabled=false --linter-enabled=false --write && tsc --noEmit"
  },
  "exports": {
    "./translation/lib": "./src/translation/lib/index.ts",
    "./translation/*": "./src/translation/language/*",
    "./*": "./src/*/index.ts"
  },
  "imports": {
    "#translation/lib": "./src/translation/lib/index.ts",
    "#translation/*": "./src/translation/language/*",
    "#*": "./src/*/index.ts"
  },
  "dependencies": {
    "@repo/ui": "*",
    "clsx": "^2.1.1",
    "i18next": "26.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "17.0.15",
    "react-router": "7.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@react-router/dev": "7.18.0",
    "@repo/biome-config": "*",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "sass": "^1.97.3",
    "typescript": "^6.0.3"
  }
}
