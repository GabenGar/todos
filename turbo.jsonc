{
  "$schema": "https://v2-11-11.turborepo.dev/schema.json",
  "futureFlags": {
    "globalConfiguration": true,
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true,
    "pruneIncludesGlobalFiles": true,
    "errorsOnlyShowHash": true,
    "longerSignatureKey": true,
    "experimentalObservability": true,
    "experimentalCargoWorkspaces": true,
    "experimentalPythonWorkspaces": true,
    
  },
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "codegen": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "prep": {},
    "start": {},
    "validate": {}
  }
}
